          "__PI_AGENT_DIR__/npm/node_modules/pi-mcp-adapter/index.ts",
          "__PI_AGENT_DIR__/npm/node_modules/billion-context-pi/dist/index.js"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "mcp",
          "compress",
          "decompress",
          "search_context",
          "acp_status"
